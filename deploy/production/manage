#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd -P)
COMPOSE_FILE="$ROOT/deploy/production/compose.yaml"
CONFIG_KEYS=''
SEEN_KEYS='|'
ENV_FILE=.env
ARG_PATH=

fail(){ printf 'PRODUCTION_CONFIG_INVALID%s\n' "${1:+: $1}" >&2; exit 64; }
note(){ printf '%s\n' "$*"; }

parse_args(){
  [[ $# -ge 1 ]] || fail verb
  VERB=$1; shift
  while (($#)); do
    case "$1" in
      --env-file) (($#>=2)) || fail ENV_FILE; ENV_FILE=$2; shift 2;;
      --backup|--output) (($#>=2)) || fail path; ARG_PATH=$2; shift 2;;
      *) fail argument;;
    esac
  done
}

regular_private(){
  [[ -f "$1" && ! -L "$1" ]] || return 1
  local mode; mode=$(stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null) || return 1
  [[ $mode == 600 ]]
}

random_hex(){ od -An -N32 -tx1 /dev/urandom | tr -d ' \n'; }

env_init(){
  local target=$ENV_FILE parent tmp line key value revision operator_home image_mode image_reference image_archive image_archive_sha
  parent=$(dirname "$target")
  [[ -d "$parent" && ! -L "$parent" ]] || fail ENV_FILE
  if [[ -e "$target" || -L "$target" ]]; then
    regular_private "$target" || fail ENV_FILE
    note 'Environment preserved.'; return 0
  fi
  operator_home=${HOME:-}
  [[ $operator_home == /* && -d $operator_home && ! -L $operator_home ]] || fail HOME
  if [[ -f "$ROOT/release.defaults" && -f "$ROOT/release.json" && -f "$ROOT/SHA256SUMS" && -f "$ROOT/images.tar" ]]; then
    (cd "$ROOT" && sha256sum -c --quiet SHA256SUMS) >/dev/null 2>&1 || fail release
    local release_keys='|' release_key release_value
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == *=* ]] || fail release
      release_key=${line%%=*}; release_value=${line#*=}
      case $release_key in
        FMONITOR_RUNTIME_IMAGE) image_reference=$release_value;;
        FMONITOR_SOURCE_REVISION) revision=$release_value;;
        FMONITOR_IMAGE_ARCHIVE_SHA256) image_archive_sha=$release_value;;
        *) fail release;;
      esac
      [[ $release_keys != *"|$release_key|"* ]] || fail release
      release_keys="$release_keys$release_key|"
    done <"$ROOT/release.defaults"
    [[ $release_keys == *'|FMONITOR_RUNTIME_IMAGE|'* && $release_keys == *'|FMONITOR_SOURCE_REVISION|'* && $release_keys == *'|FMONITOR_IMAGE_ARCHIVE_SHA256|'* ]] || fail release
    [[ $revision =~ ^[0-9a-f]{40}$ && $image_archive_sha =~ ^[0-9a-f]{64}$ && -n $image_reference ]] || fail release
    image_mode=local; image_archive="$ROOT/images.tar"
  else
    revision=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null) || fail FMONITOR_SOURCE_REVISION
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || fail FMONITOR_SOURCE_REVISION
    image_mode=build; image_reference="fmonitor2-runtime:$revision"; image_archive=''; image_archive_sha=''
  fi
  tmp="$target.new.$$.$RANDOM"
  (umask 077; set -o noclobber; : >"$tmp") 2>/dev/null || fail ENV_FILE
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == *=@GENERATE@ ]]; then line="${line%%=*}=$(random_hex)"; fi
    line=${line//@SOURCE_REVISION@/$revision}
    line=${line//@IMAGE_MODE@/$image_mode}
    line=${line//@RUNTIME_IMAGE@/$image_reference}
    line=${line//@IMAGE_ARCHIVE@/$image_archive}
    line=${line//@IMAGE_ARCHIVE_SHA256@/$image_archive_sha}
    line=${line//@DEPLOY_STATE_DIR@/$operator_home\/.fmonitor2-production-state}
    line=${line//@BACKUP_ROOT@/$operator_home\/.fmonitor2-production-backups}
    printf '%s\n' "$line" >>"$tmp" || { rm -f "$tmp"; fail ENV_FILE; }
  done <"$ROOT/deploy/production/env.example"
  chmod 600 "$tmp"
  if (set -o noclobber; ln "$tmp" "$target") 2>/dev/null; then rm -f "$tmp"; note 'Environment created.'; else rm -f "$tmp"; regular_private "$target" || fail ENV_FILE; note 'Environment preserved.'; fi
}

allowed(){
  case "$1" in
    COMPOSE_PROJECT_NAME|FMONITOR_IMAGE_MODE|FMONITOR_RUNTIME_IMAGE|FMONITOR_IMAGE_ARCHIVE|FMONITOR_IMAGE_ARCHIVE_SHA256|FMONITOR_SOURCE_REVISION|FMONITOR_HTTP_PORT|FMONITOR_DB_NAME|FMONITOR_DB_USER|FMONITOR_DB_PASSWORD|FMONITOR_MIGRATION_DB_USER|FMONITOR_MIGRATION_DB_PASSWORD|FMONITOR_PROCESS_TABLE_PREFIX|FMONITOR_LEGACY_TABLE_PREFIX|FMONITOR_SESSION_INSTANCE|FMONITOR_YII_COOKIE_VALIDATION_KEY|FMONITOR_YII_IDENTITY_KEY|FMONITOR_TRUSTED_REQUEST_HOST|FMONITOR_TRUSTED_REQUEST_SCHEME|FMONITOR_RUNTIME_ENV|FMONITOR_PUBLIC_BASE_URL|FMONITOR_ALLOW_HTTP|FMONITOR_INITIAL_OWNER_EMAIL|FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD|FMONITOR_JOBS_ENABLED|FMONITOR_DEPLOY_STATE_DIR|FMONITOR_BACKUP_ROOT|FMONITOR_BITRIX_WEBHOOK_URL|FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL|FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID|FMONITOR_BITRIX_DEPARTMENT_IDS_JSON|FMONITOR_ERP_HOST|FMONITOR_ERP_DATABASE|FMONITOR_ERP_USER|FMONITOR_ERP_PASSWORD|FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY|FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS|FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS|FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE|FMONITOR_SMTP_HOST|FMONITOR_SMTP_PORT|FMONITOR_SMTP_ENCRYPTION|FMONITOR_SMTP_USERNAME|FMONITOR_SMTP_PASSWORD|FMONITOR_SMTP_FROM_ADDRESS|FMONITOR_SMTP_FROM_NAME|FMONITOR_SMTP_TIMEOUT_SECONDS|FMONITOR_SMTP_VERIFY_PEER) return 0;;
    *) return 1;;
  esac
}

load_config(){
  regular_private "$ENV_FILE" || fail ENV_FILE
  LC_ALL=C grep -q $'\r' "$ENV_FILE" && fail ENV_FILE
  local octal
  octal=$(LC_ALL=C od -An -v -t u1 "$ENV_FILE")
  for n in $octal; do ((n==10 || (n>=32 && n!=127))) || fail ENV_FILE; done
  local line key value quote
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || fail identifier
    key=${line%%=*}; value=${line#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || fail identifier
    allowed "$key" || fail "$key"
    [[ $SEEN_KEYS != *"|$key|"* ]] || fail "$key"
    SEEN_KEYS="$SEEN_KEYS$key|"
    if [[ $value == \'* || $value == \"* ]]; then
      quote=${value:0:1}; [[ ${#value} -ge 2 && ${value: -1} == "$quote" ]] || fail "$key"
      value=${value:1:${#value}-2}
    fi
    printf -v "$key" '%s' "$value"
    CONFIG_KEYS="$CONFIG_KEYS $key"
  done <"$ENV_FILE"
}

need(){ local name=$1 value; [[ $SEEN_KEYS == *"|$name|"* ]] || fail "$name"; value=${!name}; [[ -n $value && $value != replace_me && $value != *replace_me* ]] || fail "$name"; }

validate(){
  local k
  for k in COMPOSE_PROJECT_NAME FMONITOR_IMAGE_MODE FMONITOR_RUNTIME_IMAGE FMONITOR_SOURCE_REVISION FMONITOR_HTTP_PORT FMONITOR_DB_NAME FMONITOR_DB_USER FMONITOR_DB_PASSWORD FMONITOR_MIGRATION_DB_USER FMONITOR_MIGRATION_DB_PASSWORD FMONITOR_PROCESS_TABLE_PREFIX FMONITOR_LEGACY_TABLE_PREFIX FMONITOR_SESSION_INSTANCE FMONITOR_YII_COOKIE_VALIDATION_KEY FMONITOR_YII_IDENTITY_KEY FMONITOR_TRUSTED_REQUEST_HOST FMONITOR_TRUSTED_REQUEST_SCHEME FMONITOR_RUNTIME_ENV FMONITOR_PUBLIC_BASE_URL FMONITOR_ALLOW_HTTP FMONITOR_INITIAL_OWNER_EMAIL FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD FMONITOR_JOBS_ENABLED FMONITOR_DEPLOY_STATE_DIR FMONITOR_BACKUP_ROOT; do need "$k"; done
  [[ ${COMPOSE_PROJECT_NAME} =~ ^fm2-prod-[a-z0-9][a-z0-9-]*$ ]] || fail COMPOSE_PROJECT_NAME
  [[ ${FMONITOR_IMAGE_MODE} =~ ^(build|pull|local)$ ]] || fail FMONITOR_IMAGE_MODE
  [[ ${FMONITOR_SOURCE_REVISION} =~ ^[0-9a-f]{40}$ ]] || fail FMONITOR_SOURCE_REVISION
  [[ ${FMONITOR_HTTP_PORT} =~ ^[0-9]+$ ]] && ((FMONITOR_HTTP_PORT>=1 && FMONITOR_HTTP_PORT<=65535)) || fail FMONITOR_HTTP_PORT
  [[ ${FMONITOR_PROCESS_TABLE_PREFIX} =~ ^[A-Za-z0-9_]{0,25}$ && ${FMONITOR_LEGACY_TABLE_PREFIX} =~ ^[A-Za-z0-9_]{0,25}$ ]] || fail FMONITOR_PROCESS_TABLE_PREFIX
  [[ ${FMONITOR_RUNTIME_ENV} == production ]] || fail FMONITOR_RUNTIME_ENV
  [[ ${FMONITOR_JOBS_ENABLED} =~ ^(true|false)$ ]] || fail FMONITOR_JOBS_ENABLED
  [[ ${FMONITOR_ALLOW_HTTP} =~ ^(true|false)$ ]] || fail FMONITOR_ALLOW_HTTP
  [[ ${FMONITOR_DB_USER} != root && ${FMONITOR_DB_USER} != "${FMONITOR_MIGRATION_DB_USER}" ]] || fail FMONITOR_DB_USER
  [[ ${FMONITOR_DB_NAME} =~ ^[A-Za-z0-9_]+$ && ${FMONITOR_DB_USER} =~ ^[A-Za-z0-9_]+$ && ${FMONITOR_MIGRATION_DB_USER} =~ ^[A-Za-z0-9_]+$ ]] || fail FMONITOR_DB_NAME
  [[ ${#FMONITOR_YII_COOKIE_VALIDATION_KEY} -ge 32 && ${#FMONITOR_YII_IDENTITY_KEY} -ge 32 ]] || fail FMONITOR_YII_IDENTITY_KEY
  [[ ${FMONITOR_INITIAL_OWNER_EMAIL} =~ ^[^@]+@shlz\.ru$ ]] || fail FMONITOR_INITIAL_OWNER_EMAIL
  [[ ${FMONITOR_DEPLOY_STATE_DIR} == /* && ${FMONITOR_BACKUP_ROOT} == /* ]] || fail FMONITOR_DEPLOY_STATE_DIR
  local env_parent env_absolute path parent canonical path_name
  env_parent=$(cd "$(dirname "$ENV_FILE")" 2>/dev/null && pwd -P) || fail ENV_FILE
  env_absolute="$env_parent/$(basename "$ENV_FILE")"
  if [[ $env_absolute == "$ROOT/"* && $env_absolute != "$ROOT/.env" ]]; then fail ENV_FILE; fi
  for path_name in FMONITOR_DEPLOY_STATE_DIR FMONITOR_BACKUP_ROOT; do
    path=${!path_name}
    parent=$(dirname "$path"); [[ -d $parent && ! -L $parent ]] || fail FMONITOR_DEPLOY_STATE_DIR
    canonical=$(cd "$parent" 2>/dev/null && pwd -P) || fail FMONITOR_DEPLOY_STATE_DIR
    path="$canonical/$(basename "$path")"
    [[ $path != "$ROOT" && $path != "$ROOT/"* ]] || fail FMONITOR_DEPLOY_STATE_DIR
    printf -v "$path_name" '%s' "$path"
  done
  if [[ ${FMONITOR_TRUSTED_REQUEST_SCHEME} == http ]]; then
    [[ ${FMONITOR_ALLOW_HTTP} == true && ${FMONITOR_PUBLIC_BASE_URL} =~ ^http://127\.0\.0\.1: && ${FMONITOR_TRUSTED_REQUEST_HOST} =~ ^127\.0\.0\.1: ]] || fail FMONITOR_ALLOW_HTTP
  else [[ ${FMONITOR_TRUSTED_REQUEST_SCHEME} == https && ( ${FMONITOR_PUBLIC_BASE_URL} == "https://${FMONITOR_TRUSTED_REQUEST_HOST}" || ${FMONITOR_PUBLIC_BASE_URL} == "https://${FMONITOR_TRUSTED_REQUEST_HOST}/"* ) ]] || fail FMONITOR_PUBLIC_BASE_URL; fi
  if [[ ${FMONITOR_JOBS_ENABLED} == true ]]; then
    for k in FMONITOR_BITRIX_WEBHOOK_URL FMONITOR_BITRIX_DEPARTMENT_IDS_JSON FMONITOR_ERP_HOST FMONITOR_ERP_DATABASE FMONITOR_ERP_USER FMONITOR_ERP_PASSWORD FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY FMONITOR_SMTP_HOST FMONITOR_SMTP_USERNAME FMONITOR_SMTP_PASSWORD FMONITOR_SMTP_FROM_ADDRESS; do need "$k"; done
    [[ ${FMONITOR_BITRIX_WEBHOOK_URL} =~ ^https://[A-Za-z0-9._:-]+/rest/[1-9][0-9]*/[A-Za-z0-9_-]+/?$ ]] || fail FMONITOR_BITRIX_WEBHOOK_URL
    [[ ${FMONITOR_BITRIX_DEPARTMENT_IDS_JSON} =~ ^\[[0-9,]+\]$ ]] || fail FMONITOR_BITRIX_DEPARTMENT_IDS_JSON
    if [[ -n ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL:-} ]]; then
      [[ ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL} =~ ^https://[A-Za-z0-9._:-]+/rest/[1-9][0-9]*/[A-Za-z0-9_-]+/?$ ]] || fail FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL
      [[ ${FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID:-} =~ ^[1-9][0-9]*$ ]] || fail FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID
    else [[ -z ${FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID:-} ]] || fail FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID; fi
  fi
  if [[ -n ${FMONITOR_IMAGE_ARCHIVE:-} ]]; then [[ ${FMONITOR_IMAGE_ARCHIVE} == /* && ${FMONITOR_IMAGE_ARCHIVE_SHA256:-} =~ ^[0-9a-f]{64}$ ]] || fail FMONITOR_IMAGE_ARCHIVE_SHA256; fi
}

export_config(){ local k; for k in $CONFIG_KEYS; do export "$k"; done; }
dc(){ docker compose --env-file /dev/null -p "${COMPOSE_PROJECT_NAME}" -f "$COMPOSE_FILE" "$@"; }
writers(){ local a=(php web); [[ ${FMONITOR_JOBS_ENABLED} == true ]] && a+=(jobs-worker jobs-scheduler); printf '%s\n' "${a[@]}"; }

lock(){
  local global=/tmp/fmonitor2-production-locks mode owner parent
  if [[ ! -e $global ]]; then (umask 077; mkdir "$global") || exit 75; fi
  [[ -d $global && ! -L $global ]] || fail COMPOSE_PROJECT_NAME
  mode=$(stat -c '%a' "$global" 2>/dev/null || stat -f '%Lp' "$global"); owner=$(stat -c '%u' "$global" 2>/dev/null || stat -f '%u' "$global")
  [[ $mode == 700 && $owner == "$(id -u)" ]] || fail COMPOSE_PROJECT_NAME
  parent=$(dirname "$FMONITOR_DEPLOY_STATE_DIR")
  [[ -d $parent && ! -L $parent ]] || fail FMONITOR_DEPLOY_STATE_DIR
  if [[ ! -e $FMONITOR_DEPLOY_STATE_DIR ]]; then (umask 077; mkdir "$FMONITOR_DEPLOY_STATE_DIR") || fail FMONITOR_DEPLOY_STATE_DIR; fi
  [[ -d $FMONITOR_DEPLOY_STATE_DIR && ! -L $FMONITOR_DEPLOY_STATE_DIR ]] || fail FMONITOR_DEPLOY_STATE_DIR
  mode=$(stat -c '%a' "$FMONITOR_DEPLOY_STATE_DIR" 2>/dev/null || stat -f '%Lp' "$FMONITOR_DEPLOY_STATE_DIR"); owner=$(stat -c '%u' "$FMONITOR_DEPLOY_STATE_DIR" 2>/dev/null || stat -f '%u' "$FMONITOR_DEPLOY_STATE_DIR")
  [[ $mode == 700 && $owner == "$(id -u)" ]] || fail FMONITOR_DEPLOY_STATE_DIR
  LOCK="$global/${COMPOSE_PROJECT_NAME}.lock"
  mkdir "$LOCK" 2>/dev/null || { note 'Production operation already running.' >&2; exit 75; }
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
}

prereq(){ docker info >/dev/null; docker compose version >/dev/null; }
image(){
  local acquire=${1:-acquire} mode=${FMONITOR_IMAGE_MODE} ref=${FMONITOR_RUNTIME_IMAGE} actual
  if [[ $acquire == acquire && -n ${FMONITOR_IMAGE_ARCHIVE:-} ]]; then
    [[ -f ${FMONITOR_IMAGE_ARCHIVE} && ! -L ${FMONITOR_IMAGE_ARCHIVE} ]] || fail FMONITOR_IMAGE_ARCHIVE
    actual=$(sha256sum "${FMONITOR_IMAGE_ARCHIVE}" | awk '{print $1}'); [[ $actual == "${FMONITOR_IMAGE_ARCHIVE_SHA256}" ]] || fail FMONITOR_IMAGE_ARCHIVE_SHA256
    [[ $mode == local ]] && docker load -i "${FMONITOR_IMAGE_ARCHIVE}" >/dev/null
  fi
  if [[ $acquire == acquire ]]; then case $mode in
    build) [[ $(git rev-parse HEAD) == "${FMONITOR_SOURCE_REVISION}" && -z $(git status --porcelain --untracked-files=no) ]] || fail FMONITOR_SOURCE_REVISION; docker build --build-arg "FMONITOR_SOURCE_REVISION=${FMONITOR_SOURCE_REVISION}" -f "$ROOT/deploy/runtime/Dockerfile" -t "$ref" "$ROOT";;
    pull) [[ $ref == *@sha256:* ]] || fail FMONITOR_RUNTIME_IMAGE; docker pull "$ref";;
    local) :;;
  esac; fi
  actual=$(docker image inspect "$ref" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}') || fail FMONITOR_RUNTIME_IMAGE
  [[ $actual == "${FMONITOR_SOURCE_REVISION}" ]] || fail FMONITOR_SOURCE_REVISION
  IMAGE_ID=$(docker image inspect "$ref" --format '{{.Id}}'); [[ $IMAGE_ID =~ ^sha256:[0-9a-f]{64}$ ]] || fail FMONITOR_RUNTIME_IMAGE
}

ensure_unowned_or_owned(){
  local receipt="${FMONITOR_DEPLOY_STATE_DIR}/installed"
  if [[ -f $receipt ]]; then
    local recorded actual identity_expected identity_actual resource kind
    grep -qx "project=${COMPOSE_PROJECT_NAME}" "$receipt" || fail COMPOSE_PROJECT_NAME
    identity_expected=$(sed -n 's/^identity_hash=//p' "$receipt")
    identity_actual=$(printf '%s\0' "$COMPOSE_PROJECT_NAME" "$FMONITOR_DB_NAME" "$FMONITOR_DB_USER" "$FMONITOR_DB_PASSWORD" "$FMONITOR_PROCESS_TABLE_PREFIX" "$FMONITOR_SESSION_INSTANCE" "$FMONITOR_YII_COOKIE_VALIDATION_KEY" "$FMONITOR_YII_IDENTITY_KEY" | sha256sum | awk '{print $1}')
    [[ $identity_expected == "$identity_actual" ]] || fail FMONITOR_YII_IDENTITY_KEY
    for resource in database state secrets; do
      recorded=$(sed -n "s/^${resource}_id=//p" "$receipt")
      if [[ $recorded != pending ]]; then actual=$(volume_identity "${COMPOSE_PROJECT_NAME}_${resource}") || fail COMPOSE_PROJECT_NAME; [[ $actual == "$recorded" ]] || fail COMPOSE_PROJECT_NAME; fi
    done
    recorded=$(sed -n 's/^network_id=//p' "$receipt")
    if [[ $recorded != pending ]]; then actual=$(network_identity "${COMPOSE_PROJECT_NAME}_default") || fail COMPOSE_PROJECT_NAME; [[ $actual == "$recorded" ]] || fail COMPOSE_PROJECT_NAME; fi
    return
  fi
  local existing; existing=$(docker ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}")
  [[ -z $existing ]] || fail COMPOSE_PROJECT_NAME
  for suffix in database state secrets; do docker volume inspect "${COMPOSE_PROJECT_NAME}_${suffix}" >/dev/null 2>&1 && fail COMPOSE_PROJECT_NAME || true; done
  docker network inspect "${COMPOSE_PROJECT_NAME}_default" >/dev/null 2>&1 && fail COMPOSE_PROJECT_NAME || true
}

stage_integrations(){
  if [[ $FMONITOR_JOBS_ENABLED == true ]]; then
    local bitrix="${FMONITOR_DEPLOY_STATE_DIR}/bitrix.json" document=null
    [[ -z ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL:-} ]] || document="\"${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL}\""
    (umask 077; printf '{"baseUrl":"%s","departments":%s,"documentBaseUrl":%s}\n' "$FMONITOR_BITRIX_WEBHOOK_URL" "$FMONITOR_BITRIX_DEPARTMENT_IDS_JSON" "$document" >"$bitrix")
    export FMONITOR_BITRIX_CONFIG_HOST_FILE=$bitrix
    dc --profile deployment run --rm stage-runtime-secrets
  fi
}

provision(){
  dc up -d --wait db
  if grep -qx 'state=initializing' "${FMONITOR_DEPLOY_STATE_DIR}/installed" 2>/dev/null; then receipt initializing; fi
  dc --profile deployment run --rm -e FMONITOR_MIGRATION_DB_USER -e FMONITOR_MIGRATION_DB_PASSWORD --entrypoint php prepare bin/yii local-runtime/provision-database --interactive=0
  dc --profile deployment run --rm initialize-state
  dc --profile deployment run --rm prepare
  stage_integrations
  dc --profile deployment run --rm migrate
  dc --profile deployment run --rm --entrypoint php prepare bin/fmonitor2-runtime-check.php
}

health(){
  dc exec -T php php bin/fmonitor2-runtime-check.php >/dev/null
  dc exec -T web curl --fail --silent --show-error --header "Host: ${FMONITOR_TRUSTED_REQUEST_HOST}" http://127.0.0.1:8080/health/ready >/dev/null
}

start_services(){ local a=(); while IFS= read -r x; do a+=("$x"); done < <(writers); dc up -d --wait "${a[@]}"; health; }

volume_identity(){ docker volume inspect "$1" --format '{{.Name}}|{{.Driver}}|{{.CreatedAt}}|{{json .Labels}}|{{json .Options}}' | sha256sum | awk '{print $1}'; }
network_identity(){ docker network inspect "$1" --format '{{.Id}}|{{.Created}}|{{.Driver}}|{{json .Labels}}|{{json .Options}}' | sha256sum | awk '{print $1}'; }
installed_env_path(){ printf '%s/installed.env\n' "$FMONITOR_DEPLOY_STATE_DIR"; }
persist_installed_env(){ local target tmp; target=$(installed_env_path); tmp="$target.new.$$.$RANDOM"; (umask 077; cp "$ENV_FILE" "$tmp" && chmod 600 "$tmp") || { rm -f "$tmp"; return 1; }; mv "$tmp" "$target"; }

receipt(){
  local state=${1:-installed} tmp="${FMONITOR_DEPLOY_STATE_DIR}/installed.new.$$"
  local config_hash identity_hash database_id=pending state_id=pending secrets_id=pending network_id=pending
  config_hash=$(sha256sum "$ENV_FILE" | awk '{print $1}')
  identity_hash=$(printf '%s\0' "$COMPOSE_PROJECT_NAME" "$FMONITOR_DB_NAME" "$FMONITOR_DB_USER" "$FMONITOR_DB_PASSWORD" "$FMONITOR_PROCESS_TABLE_PREFIX" "$FMONITOR_SESSION_INSTANCE" "$FMONITOR_YII_COOKIE_VALIDATION_KEY" "$FMONITOR_YII_IDENTITY_KEY" | sha256sum | awk '{print $1}')
  docker volume inspect "${COMPOSE_PROJECT_NAME}_database" >/dev/null 2>&1 && database_id=$(volume_identity "${COMPOSE_PROJECT_NAME}_database")
  docker volume inspect "${COMPOSE_PROJECT_NAME}_state" >/dev/null 2>&1 && state_id=$(volume_identity "${COMPOSE_PROJECT_NAME}_state")
  docker volume inspect "${COMPOSE_PROJECT_NAME}_secrets" >/dev/null 2>&1 && secrets_id=$(volume_identity "${COMPOSE_PROJECT_NAME}_secrets")
  docker network inspect "${COMPOSE_PROJECT_NAME}_default" >/dev/null 2>&1 && network_id=$(network_identity "${COMPOSE_PROJECT_NAME}_default")
  (umask 077; printf 'project=%s\nsource=%s\nimage=%s\nimage_id=%s\ndatabase_id=%s\nstate_id=%s\nsecrets_id=%s\nnetwork_id=%s\nconfig_hash=%s\nidentity_hash=%s\nstate=%s\n' "${COMPOSE_PROJECT_NAME}" "${FMONITOR_SOURCE_REVISION}" "${FMONITOR_RUNTIME_IMAGE}" "$IMAGE_ID" "$database_id" "$state_id" "$secrets_id" "$network_id" "$config_hash" "$identity_hash" "$state" >"$tmp")
  [[ $state != installed ]] || persist_installed_env
  mv "$tmp" "${FMONITOR_DEPLOY_STATE_DIR}/installed"
  chmod 600 "${FMONITOR_DEPLOY_STATE_DIR}/installed"
}

deploy(){
  lock; prereq
  local installed="${FMONITOR_DEPLOY_STATE_DIR}/installed"
  if [[ -f $installed ]]; then image verify; else image; fi
  ensure_unowned_or_owned
  if [[ -f $installed ]]; then
    local configured_hash installed_hash
    configured_hash=$(sha256sum "$ENV_FILE" | awk '{print $1}'); installed_hash=$(sed -n 's/^config_hash=//p' "$installed")
    [[ $configured_hash == "$installed_hash" ]] || fail update
    grep -qx "source=${FMONITOR_SOURCE_REVISION}" "$installed" || fail update
    grep -qx "image=${FMONITOR_RUNTIME_IMAGE}" "$installed" || fail update
    grep -qx "image_id=$IMAGE_ID" "$installed" || fail update
    if grep -qx 'state=installed' "$installed"; then start_services; return; fi
    grep -qx 'state=initializing' "$installed" || fail update
  else
    receipt initializing
  fi
  provision
  dc --profile deployment run --rm -e FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD --entrypoint php prepare bin/fmonitor2-provision-initial-admin.php --email "${FMONITOR_INITIAL_OWNER_EMAIL}"
  start_services; receipt installed
}

installed(){ local mode=${1:-exact} f="${FMONITOR_DEPLOY_STATE_DIR}/installed" expected actual; [[ -f $f && ! -L $f ]] || fail installation; grep -qx "project=${COMPOSE_PROJECT_NAME}" "$f" || fail installation; grep -qx 'state=installed' "$f" || fail update; expected=$(sed -n 's/^identity_hash=//p' "$f"); actual=$(printf '%s\0' "$COMPOSE_PROJECT_NAME" "$FMONITOR_DB_NAME" "$FMONITOR_DB_USER" "$FMONITOR_DB_PASSWORD" "$FMONITOR_PROCESS_TABLE_PREFIX" "$FMONITOR_SESSION_INSTANCE" "$FMONITOR_YII_COOKIE_VALIDATION_KEY" "$FMONITOR_YII_IDENTITY_KEY" | sha256sum | awk '{print $1}'); [[ $expected == "$actual" ]] || fail FMONITOR_YII_IDENTITY_KEY; if [[ $mode == exact ]]; then expected=$(sed -n 's/^config_hash=//p' "$f"); actual=$(sha256sum "$ENV_FILE" | awk '{print $1}'); [[ $expected == "$actual" ]] || fail update; grep -qx "source=${FMONITOR_SOURCE_REVISION}" "$f" || fail update; grep -qx "image=${FMONITOR_RUNTIME_IMAGE}" "$f" || fail update; fi; }
installed_image(){ local expected actual; expected=$(sed -n 's/^image_id=//p' "${FMONITOR_DEPLOY_STATE_DIR}/installed"); actual=$(docker image inspect "$FMONITOR_RUNTIME_IMAGE" --format '{{.Id}}') || fail FMONITOR_RUNTIME_IMAGE; [[ $actual == "$expected" ]] || fail FMONITOR_RUNTIME_IMAGE; }

stop_cmd(){ lock; installed any; local service running=(); for service in jobs-scheduler jobs-worker web php; do dc ps --status running --services | grep -qx "$service" && running+=("$service") || true; done; ((${#running[@]}==0)) || dc stop "${running[@]}"; }
start_cmd(){ lock; installed; installed_image; start_services; }
status_cmd(){ installed; installed_image; dc ps; health; if [[ $FMONITOR_JOBS_ENABLED == false ]]; then ! dc ps --status running --services | grep -Eq '^jobs-(worker|scheduler)$' || fail FMONITOR_JOBS_ENABLED; note 'jobs: disabled'; fi; }

if [[ -f "$ROOT/deploy/production/recovery.sh" ]]; then
  source "$ROOT/deploy/production/recovery.sh"
else
  do_backup(){ fail recovery; }; update_cmd(){ fail recovery; }; restore_cmd(){ fail recovery; }; release_cmd(){ fail recovery; }
fi

main(){
  parse_args "$@"
  [[ $VERB == env-init ]] && { env_init; return; }
  while IFS='=' read -r inherited _; do case $inherited in FMONITOR_*|COMPOSE_*) unset "$inherited";; esac; done < <(env)
  load_config
  if [[ $VERB == is-production ]]; then [[ ${FMONITOR_RUNTIME_ENV:-} == production && ${COMPOSE_PROJECT_NAME:-} =~ ^fm2-prod- ]] && return 0; return 1; fi
  validate
  [[ $VERB == check-config ]] && return
  export_config
  case $VERB in
    deploy) deploy;; status) status_cmd;; logs) installed; installed_image; dc logs --follow;; stop) stop_cmd;; start) start_cmd;; backup) do_backup;; update) update_cmd;; restore) restore_cmd;; release) release_cmd;; *) fail verb;;
  esac
}
main "$@"
