#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd -P)
COMPOSE_FILE="$ROOT/deploy/production/compose.yaml"
CONFIG_KEYS=''
SEEN_KEYS='|'
ENV_FILE=.env
ARG_PATH=
PREPARED_ENV=false
PREPARED_ENV_IDENTITY=
PREPARED_ENV_DIGEST=
ENV_SNAPSHOT=

fail(){ printf 'PRODUCTION_CONFIG_INVALID%s\n' "${1:+: $1}" >&2; exit 64; }
note(){ printf '%s\n' "$*"; }

parse_args(){
  [[ $# -ge 1 ]] || fail verb
  VERB=$1; shift
  while (($#)); do
    case "$1" in
      --env-file) (($#>=2)) || fail ENV_FILE; ENV_FILE=$2; shift 2;;
      --backup|--output) (($#>=2)) || fail path; ARG_PATH=$2; shift 2;;
      *) fail argument;;
    esac
  done
}

regular_private(){
  [[ -f "$1" && ! -L "$1" ]] || return 1
  local mode; mode=$(stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null) || return 1
  [[ $mode == 600 ]]
}

path_identity(){
  stat -c '%d:%i:%u:%h:%a' -- "$1" 2>/dev/null || stat -f '%d:%i:%u:%l:%Lp' "$1" 2>/dev/null
}

fd_identity(){
  stat -L -c '%i:%u:%h:%a' -- /dev/fd/9 2>/dev/null || stat -L -f '%i:%u:%l:%Lp' /dev/fd/9 2>/dev/null
}

prepare_deploy_env_file(){
  local env_parent env_absolute before stable opened after_fd after_path digest snapshot_digest after_digest mode inode uid links captured
  env_parent=$(cd "$(dirname "$ENV_FILE")" 2>/dev/null && pwd -P) || fail ENV_FILE
  env_absolute="$env_parent/$(basename "$ENV_FILE")"
  [[ $env_absolute == "$ROOT/.env" ]] || return 0
  [[ -f "$ENV_FILE" && ! -L "$ENV_FILE" ]] || fail ENV_FILE
  before=$(path_identity "$ENV_FILE") || fail ENV_FILE
  IFS=: read -r _ inode uid links mode <<EOF
$before
EOF
  [[ $uid == "$(id -u)" && $links == 1 ]] || fail ENV_FILE
  digest=$(sha256sum "$ENV_FILE" | awk '{print $1}') || fail ENV_FILE
  stable=$(path_identity "$ENV_FILE") || fail ENV_FILE
  [[ $stable == "$before" && -f $ENV_FILE && ! -L $ENV_FILE ]] || fail ENV_FILE
  exec 9<>"$ENV_FILE" || fail ENV_FILE
  opened=$(fd_identity) || { exec 9<&-; fail ENV_FILE; }
  [[ $opened == "$inode:$uid:$links:$mode" ]] || { exec 9<&-; fail ENV_FILE; }
  captured=$( { cat <&9; printf '\001'; } ) || { exec 9<&-; fail ENV_FILE; }
  ENV_SNAPSHOT=${captured%$'\001'}
  snapshot_digest=$(printf '%s' "$ENV_SNAPSHOT" | sha256sum | awk '{print $1}') || { exec 9<&-; fail ENV_FILE; }
  [[ $snapshot_digest == "$digest" ]] || { exec 9<&-; ENV_SNAPSHOT=; fail ENV_FILE; }
  if [[ $mode != 600 ]]; then
    chmod 0600 /dev/fd/9 || { exec 9<&-; note 'Use a Linux filesystem or WSL filesystem that supports private file modes.' >&2; return 64; }
  fi
  after_fd=$(fd_identity) || { exec 9<&-; fail ENV_FILE; }
  after_path=$(path_identity "$ENV_FILE") || { exec 9<&-; fail ENV_FILE; }
  [[ $after_fd == "$inode:$uid:$links:600" ]] || { exec 9<&-; note 'Use a Linux filesystem or WSL filesystem that supports private file modes.' >&2; return 64; }
  [[ $after_path == "${before%:*}:600" && -f $ENV_FILE && ! -L $ENV_FILE ]] || { exec 9<&-; fail ENV_FILE; }
  after_digest=$(sha256sum "$ENV_FILE" | awk '{print $1}') || { exec 9<&-; fail ENV_FILE; }
  exec 9<&-
  [[ $after_digest == "$digest" ]] || fail ENV_FILE
  PREPARED_ENV=true
  PREPARED_ENV_IDENTITY="${before%:*}:600"
  PREPARED_ENV_DIGEST=$digest
}

read_config_bytes(){
  if [[ $PREPARED_ENV == true ]]; then printf '%s' "$ENV_SNAPSHOT"; else cat -- "$ENV_FILE"; fi
}

finalize_prepared_env(){
  [[ $PREPARED_ENV == true ]] || return 0
  local identity digest
  identity=$(path_identity "$ENV_FILE") || fail ENV_FILE
  [[ $identity == "$PREPARED_ENV_IDENTITY" && -f $ENV_FILE && ! -L $ENV_FILE ]] || fail ENV_FILE
  digest=$(sha256sum "$ENV_FILE" | awk '{print $1}') || fail ENV_FILE
  [[ $digest == "$PREPARED_ENV_DIGEST" ]] || fail ENV_FILE
  ENV_SNAPSHOT=
  PREPARED_ENV=false
}

random_hex(){ od -An -N32 -tx1 /dev/urandom | tr -d ' \n'; }

resolve_build_identity(){
  [[ ${FMONITOR_IMAGE_MODE:-} == build ]] || return 0
  local receipt="${FMONITOR_DEPLOY_STATE_DIR}/installed" head recorded_source recorded_state
  if [[ $VERB == deploy || $VERB == update ]]; then
    head=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null) || fail FMONITOR_SOURCE_REVISION
    [[ $head =~ ^[0-9a-f]{40}$ && -z $(git -C "$ROOT" status --porcelain --untracked-files=all) ]] || fail FMONITOR_SOURCE_REVISION
    if [[ -f $receipt ]]; then
      recorded_source=$(sed -n 's/^source=//p' "$receipt")
      recorded_state=$(sed -n 's/^state=//p' "$receipt")
      if [[ $recorded_source == "$head" || ( $VERB == deploy && $recorded_state != initializing ) ]]; then
        FMONITOR_SOURCE_REVISION=$recorded_source
        FMONITOR_RUNTIME_IMAGE=$(sed -n 's/^image=//p' "$receipt")
        FMONITOR_APPLICATION_IMAGE_ID=$(sed -n 's/^image_id=//p' "$receipt")
        FMONITOR_APPLICATION_PLATFORM=$(sed -n 's/^application_platform=//p' "$receipt")
        return 0
      fi
    fi
    FMONITOR_SOURCE_REVISION=$head
    FMONITOR_RUNTIME_IMAGE="fmonitor2-runtime:${head}-$(random_hex | cut -c1-12)"
    FMONITOR_APPLICATION_IMAGE_ID=
    FMONITOR_APPLICATION_PLATFORM=
    return 0
  fi
  if [[ -f $receipt ]]; then
    FMONITOR_SOURCE_REVISION=$(sed -n 's/^source=//p' "$receipt")
    FMONITOR_RUNTIME_IMAGE=$(sed -n 's/^image=//p' "$receipt")
    FMONITOR_APPLICATION_IMAGE_ID=$(sed -n 's/^image_id=//p' "$receipt")
    FMONITOR_APPLICATION_PLATFORM=$(sed -n 's/^application_platform=//p' "$receipt")
  fi
}

env_init(){
  local target=$ENV_FILE parent tmp line key value revision operator_home image_mode image_reference application_image_id image_archive image_archive_sha database_image database_image_id application_platform database_platform
  parent=$(dirname "$target")
  [[ -d "$parent" && ! -L "$parent" ]] || fail ENV_FILE
  if [[ -e "$target" || -L "$target" ]]; then
    regular_private "$target" || fail ENV_FILE
    note 'Environment preserved.'; return 0
  fi
  operator_home=${HOME:-}
  [[ $operator_home == /* && -d $operator_home && ! -L $operator_home ]] || fail HOME
  if [[ -f "$ROOT/release.defaults" && -f "$ROOT/release.json" && -f "$ROOT/SHA256SUMS" && -f "$ROOT/images.tar" ]]; then
    (cd "$ROOT" && sha256sum -c --quiet SHA256SUMS) >/dev/null 2>&1 || fail release
    local release_keys='|' release_key release_value
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == *=* ]] || fail release
      release_key=${line%%=*}; release_value=${line#*=}
      case $release_key in
        FMONITOR_RUNTIME_IMAGE) image_reference=$release_value;;
        FMONITOR_APPLICATION_IMAGE_ID) application_image_id=$release_value;;
        FMONITOR_SOURCE_REVISION) revision=$release_value;;
        FMONITOR_IMAGE_ARCHIVE_SHA256) image_archive_sha=$release_value;;
        FMONITOR_DATABASE_IMAGE) database_image=$release_value;;
        FMONITOR_DATABASE_IMAGE_ID) database_image_id=$release_value;;
        FMONITOR_APPLICATION_PLATFORM) application_platform=$release_value;;
        FMONITOR_DATABASE_PLATFORM) database_platform=$release_value;;
        *) fail release;;
      esac
      [[ $release_keys != *"|$release_key|"* ]] || fail release
      release_keys="$release_keys$release_key|"
    done <"$ROOT/release.defaults"
    [[ $release_keys == '|FMONITOR_RUNTIME_IMAGE|FMONITOR_SOURCE_REVISION|FMONITOR_IMAGE_ARCHIVE_SHA256|FMONITOR_APPLICATION_IMAGE_ID|FMONITOR_DATABASE_IMAGE|FMONITOR_DATABASE_IMAGE_ID|FMONITOR_APPLICATION_PLATFORM|FMONITOR_DATABASE_PLATFORM|' ]] || fail release
    [[ $revision =~ ^[0-9a-f]{40}$ && $image_archive_sha =~ ^[0-9a-f]{64}$ && $application_image_id =~ ^sha256:[0-9a-f]{64}$ && $database_image_id =~ ^sha256:[0-9a-f]{64}$ && $application_platform =~ ^[a-z0-9]+/[a-z0-9_]+$ && $database_platform =~ ^[a-z0-9]+/[a-z0-9_]+$ && -n $image_reference && -n $database_image ]] || fail release
    image_mode=local; image_archive="$ROOT/images.tar"
  else
    revision=$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null) || fail FMONITOR_SOURCE_REVISION
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || fail FMONITOR_SOURCE_REVISION
    image_mode=build; image_reference="fmonitor2-runtime:${revision}-$(random_hex | cut -c1-12)"; application_image_id=''; image_archive=''; image_archive_sha=''; database_image=mariadb:11.4.7-noble; database_image_id=''; application_platform=''; database_platform=''
  fi
  tmp="$target.new.$$.$RANDOM"
  (umask 077; set -o noclobber; : >"$tmp") 2>/dev/null || fail ENV_FILE
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == *=@GENERATE@ ]]; then line="${line%%=*}=$(random_hex)"; fi
    line=${line//@SOURCE_REVISION@/$revision}
    line=${line//@IMAGE_MODE@/$image_mode}
    line=${line//@RUNTIME_IMAGE@/$image_reference}
    line=${line//@APPLICATION_IMAGE_ID@/$application_image_id}
    line=${line//@DATABASE_IMAGE@/$database_image}
    line=${line//@DATABASE_IMAGE_ID@/$database_image_id}
    line=${line//@APPLICATION_PLATFORM@/$application_platform}
    line=${line//@DATABASE_PLATFORM@/$database_platform}
    line=${line//@IMAGE_ARCHIVE@/$image_archive}
    line=${line//@IMAGE_ARCHIVE_SHA256@/$image_archive_sha}
    printf '%s\n' "$line" >>"$tmp" || { rm -f "$tmp"; fail ENV_FILE; }
  done <"$ROOT/deploy/production/env.example"
  chmod 600 "$tmp"
  if (set -o noclobber; ln "$tmp" "$target") 2>/dev/null; then rm -f "$tmp"; note 'Environment created.'; else rm -f "$tmp"; regular_private "$target" || fail ENV_FILE; note 'Environment preserved.'; fi
}

allowed(){
  case "$1" in
    COMPOSE_PROJECT_NAME|FMONITOR_IMAGE_MODE|FMONITOR_RUNTIME_IMAGE|FMONITOR_APPLICATION_IMAGE_ID|FMONITOR_DATABASE_IMAGE|FMONITOR_DATABASE_IMAGE_ID|FMONITOR_APPLICATION_PLATFORM|FMONITOR_DATABASE_PLATFORM|FMONITOR_IMAGE_ARCHIVE|FMONITOR_IMAGE_ARCHIVE_SHA256|FMONITOR_SOURCE_REVISION|FMONITOR_HTTP_PORT|FMONITOR_DB_NAME|FMONITOR_DB_USER|FMONITOR_DB_PASSWORD|FMONITOR_MIGRATION_DB_USER|FMONITOR_MIGRATION_DB_PASSWORD|FMONITOR_PROCESS_TABLE_PREFIX|FMONITOR_LEGACY_TABLE_PREFIX|FMONITOR_SESSION_INSTANCE|FMONITOR_YII_COOKIE_VALIDATION_KEY|FMONITOR_YII_IDENTITY_KEY|FMONITOR_TRUSTED_REQUEST_HOST|FMONITOR_TRUSTED_REQUEST_SCHEME|FMONITOR_RUNTIME_ENV|FMONITOR_PUBLIC_BASE_URL|FMONITOR_ALLOW_HTTP|FMONITOR_INITIAL_OWNER_EMAIL|FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD|FMONITOR_JOBS_ENABLED|FMONITOR_DEPLOY_STATE_DIR|FMONITOR_BACKUP_ROOT|FMONITOR_BITRIX_WEBHOOK_URL|FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL|FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID|FMONITOR_BITRIX_DEPARTMENT_IDS_JSON|FMONITOR_ERP_HOST|FMONITOR_ERP_DATABASE|FMONITOR_ERP_USER|FMONITOR_ERP_PASSWORD|FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY|FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS|FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS|FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE|FMONITOR_SMTP_HOST|FMONITOR_SMTP_PORT|FMONITOR_SMTP_ENCRYPTION|FMONITOR_SMTP_USERNAME|FMONITOR_SMTP_PASSWORD|FMONITOR_SMTP_FROM_ADDRESS|FMONITOR_SMTP_FROM_NAME|FMONITOR_SMTP_TIMEOUT_SECONDS|FMONITOR_SMTP_VERIFY_PEER) return 0;;
    *) return 1;;
  esac
}

load_config(){
  regular_private "$ENV_FILE" || fail ENV_FILE
  read_config_bytes | LC_ALL=C grep -q $'\r' && fail ENV_FILE
  local octal
  octal=$(read_config_bytes | LC_ALL=C od -An -v -t u1)
  for n in $octal; do ((n==10 || (n>=32 && n!=127))) || fail ENV_FILE; done
  local line key value quote
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || fail identifier
    key=${line%%=*}; value=${line#*=}
    [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || fail identifier
    allowed "$key" || fail "$key"
    [[ $SEEN_KEYS != *"|$key|"* ]] || fail "$key"
    SEEN_KEYS="$SEEN_KEYS$key|"
    if [[ $value == \'* || $value == \"* ]]; then
      quote=${value:0:1}; [[ ${#value} -ge 2 && ${value: -1} == "$quote" ]] || fail "$key"
      value=${value:1:${#value}-2}
    fi
    printf -v "$key" '%s' "$value"
    CONFIG_KEYS="$CONFIG_KEYS $key"
  done < <(read_config_bytes)
}

need(){ local name=$1 value; [[ $SEEN_KEYS == *"|$name|"* ]] || fail "$name"; value=${!name}; [[ -n $value && $value != replace_me && $value != *replace_me* ]] || fail "$name"; }

AUTO_STATE=false
AUTO_BACKUP=false
MANAGED_PROJECT_ROOT=

resolve_auto_paths(){
  local canonical_home home_uid
  [[ ${FMONITOR_DEPLOY_STATE_DIR:-} == auto || ${FMONITOR_BACKUP_ROOT:-} == auto ]] || return 0
  [[ $HOME == /* && -d $HOME && ! -L $HOME ]] || fail HOME
  home_uid=$(stat -c '%u' "$HOME" 2>/dev/null || stat -f '%u' "$HOME") || fail HOME
  [[ $home_uid == "$(id -u)" ]] || fail HOME
  canonical_home=$(cd "$HOME" 2>/dev/null && pwd -P) || fail HOME
  [[ $canonical_home == "$HOME" ]] || fail HOME
  [[ ${COMPOSE_PROJECT_NAME:-} =~ ^fm2-prod-[a-z0-9][a-z0-9-]*$ ]] || fail COMPOSE_PROJECT_NAME
  MANAGED_PROJECT_ROOT="$canonical_home/.fmonitor2-production/$COMPOSE_PROJECT_NAME"
  if [[ ${FMONITOR_DEPLOY_STATE_DIR:-} == auto ]]; then AUTO_STATE=true; FMONITOR_DEPLOY_STATE_DIR="$MANAGED_PROJECT_ROOT/state"; fi
  if [[ ${FMONITOR_BACKUP_ROOT:-} == auto ]]; then AUTO_BACKUP=true; FMONITOR_BACKUP_ROOT="$MANAGED_PROJECT_ROOT/backups"; fi
}

private_directory(){
  local path=$1 mode owner
  [[ -d $path && ! -L $path ]] || return 1
  mode=$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path") || return 1
  owner=$(stat -c '%u' "$path" 2>/dev/null || stat -f '%u' "$path") || return 1
  [[ $mode == 700 && $owner == "$(id -u)" ]]
}

create_private_directory(){
  local path=$1
  if [[ ! -e $path && ! -L $path ]]; then (umask 077; mkdir "$path") || fail "$2"; fi
  private_directory "$path" || fail "$2"
}

prepare_managed_paths(){
  [[ $AUTO_STATE == true || $AUTO_BACKUP == true ]] || return 0
  local base="$HOME/.fmonitor2-production"
  create_private_directory "$base" HOME
  create_private_directory "$MANAGED_PROJECT_ROOT" COMPOSE_PROJECT_NAME
  [[ $AUTO_STATE == false ]] || create_private_directory "$FMONITOR_DEPLOY_STATE_DIR" FMONITOR_DEPLOY_STATE_DIR
  [[ $AUTO_BACKUP == false ]] || create_private_directory "$FMONITOR_BACKUP_ROOT" FMONITOR_BACKUP_ROOT
}

validate(){
  local k
  for k in COMPOSE_PROJECT_NAME FMONITOR_IMAGE_MODE FMONITOR_DATABASE_IMAGE FMONITOR_HTTP_PORT FMONITOR_DB_NAME FMONITOR_DB_USER FMONITOR_DB_PASSWORD FMONITOR_MIGRATION_DB_USER FMONITOR_MIGRATION_DB_PASSWORD FMONITOR_PROCESS_TABLE_PREFIX FMONITOR_LEGACY_TABLE_PREFIX FMONITOR_SESSION_INSTANCE FMONITOR_YII_COOKIE_VALIDATION_KEY FMONITOR_YII_IDENTITY_KEY FMONITOR_TRUSTED_REQUEST_HOST FMONITOR_TRUSTED_REQUEST_SCHEME FMONITOR_RUNTIME_ENV FMONITOR_PUBLIC_BASE_URL FMONITOR_ALLOW_HTTP FMONITOR_INITIAL_OWNER_EMAIL FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD FMONITOR_JOBS_ENABLED FMONITOR_DEPLOY_STATE_DIR FMONITOR_BACKUP_ROOT; do need "$k"; done
  if [[ ${FMONITOR_IMAGE_MODE} != build ]]; then need FMONITOR_RUNTIME_IMAGE; need FMONITOR_SOURCE_REVISION; fi
  [[ ${COMPOSE_PROJECT_NAME} =~ ^fm2-prod-[a-z0-9][a-z0-9-]*$ ]] || fail COMPOSE_PROJECT_NAME
  [[ ${FMONITOR_IMAGE_MODE} =~ ^(build|pull|local)$ ]] || fail FMONITOR_IMAGE_MODE
  [[ -z ${FMONITOR_APPLICATION_IMAGE_ID:-} || ${FMONITOR_APPLICATION_IMAGE_ID} =~ ^sha256:[0-9a-f]{64}$ ]] || fail FMONITOR_APPLICATION_IMAGE_ID
  if [[ -n ${FMONITOR_IMAGE_ARCHIVE:-} ]]; then need FMONITOR_APPLICATION_IMAGE_ID; fi
  [[ -z ${FMONITOR_DATABASE_IMAGE_ID:-} || ${FMONITOR_DATABASE_IMAGE_ID} =~ ^sha256:[0-9a-f]{64}$ ]] || fail FMONITOR_DATABASE_IMAGE_ID
  [[ -z ${FMONITOR_APPLICATION_PLATFORM:-} || ${FMONITOR_APPLICATION_PLATFORM} =~ ^[a-z0-9]+/[a-z0-9_]+$ ]] || fail FMONITOR_APPLICATION_PLATFORM
  [[ -z ${FMONITOR_DATABASE_PLATFORM:-} || ${FMONITOR_DATABASE_PLATFORM} =~ ^[a-z0-9]+/[a-z0-9_]+$ ]] || fail FMONITOR_DATABASE_PLATFORM
  [[ ${FMONITOR_SOURCE_REVISION} =~ ^[0-9a-f]{40}$ ]] || fail FMONITOR_SOURCE_REVISION
  [[ ${FMONITOR_HTTP_PORT} =~ ^[0-9]+$ ]] && ((FMONITOR_HTTP_PORT>=1 && FMONITOR_HTTP_PORT<=65535)) || fail FMONITOR_HTTP_PORT
  [[ ${FMONITOR_PROCESS_TABLE_PREFIX} =~ ^[A-Za-z0-9_]{0,25}$ && ${FMONITOR_LEGACY_TABLE_PREFIX} =~ ^[A-Za-z0-9_]{0,25}$ ]] || fail FMONITOR_PROCESS_TABLE_PREFIX
  [[ ${FMONITOR_RUNTIME_ENV} == production ]] || fail FMONITOR_RUNTIME_ENV
  [[ ${FMONITOR_JOBS_ENABLED} =~ ^(true|false)$ ]] || fail FMONITOR_JOBS_ENABLED
  [[ ${FMONITOR_ALLOW_HTTP} =~ ^(true|false)$ ]] || fail FMONITOR_ALLOW_HTTP
  [[ ${FMONITOR_DB_USER} != root && ${FMONITOR_DB_USER} != "${FMONITOR_MIGRATION_DB_USER}" ]] || fail FMONITOR_DB_USER
  [[ ${FMONITOR_DB_NAME} =~ ^[A-Za-z0-9_]+$ && ${FMONITOR_DB_USER} =~ ^[A-Za-z0-9_]+$ && ${FMONITOR_MIGRATION_DB_USER} =~ ^[A-Za-z0-9_]+$ ]] || fail FMONITOR_DB_NAME
  [[ ${#FMONITOR_YII_COOKIE_VALIDATION_KEY} -ge 32 && ${#FMONITOR_YII_IDENTITY_KEY} -ge 32 ]] || fail FMONITOR_YII_IDENTITY_KEY
  [[ ${FMONITOR_INITIAL_OWNER_EMAIL} =~ ^[^@]+@shlz\.ru$ ]] || fail FMONITOR_INITIAL_OWNER_EMAIL
  [[ ${FMONITOR_DEPLOY_STATE_DIR} == /* && ${FMONITOR_BACKUP_ROOT} == /* ]] || fail FMONITOR_DEPLOY_STATE_DIR
  if [[ $AUTO_STATE == true || $AUTO_BACKUP == true ]]; then
    local managed_component
    for managed_component in "$HOME/.fmonitor2-production" "$MANAGED_PROJECT_ROOT"; do
      if [[ -e $managed_component || -L $managed_component ]]; then private_directory "$managed_component" || fail FMONITOR_DEPLOY_STATE_DIR; fi
    done
  fi
  local env_parent env_absolute path parent canonical path_name
  env_parent=$(cd "$(dirname "$ENV_FILE")" 2>/dev/null && pwd -P) || fail ENV_FILE
  env_absolute="$env_parent/$(basename "$ENV_FILE")"
  if [[ $env_absolute == "$ROOT/"* && $env_absolute != "$ROOT/.env" ]]; then fail ENV_FILE; fi
  for path_name in FMONITOR_DEPLOY_STATE_DIR FMONITOR_BACKUP_ROOT; do
    path=${!path_name}
    parent=$(dirname "$path")
    if [[ ! -d $parent || -L $parent ]]; then
      if { [[ $path_name == FMONITOR_DEPLOY_STATE_DIR && $AUTO_STATE == true ]] || [[ $path_name == FMONITOR_BACKUP_ROOT && $AUTO_BACKUP == true ]]; } \
        && [[ $VERB == deploy || $VERB == check-config ]]; then continue; fi
      fail FMONITOR_DEPLOY_STATE_DIR
    fi
    local parent_mode parent_owner
    parent_mode=$(stat -c '%a' "$parent" 2>/dev/null || stat -f '%Lp' "$parent"); parent_owner=$(stat -c '%u' "$parent" 2>/dev/null || stat -f '%u' "$parent")
    [[ $parent_mode == 700 && $parent_owner == "$(id -u)" ]] || fail "$path_name"
    canonical=$(cd "$parent" 2>/dev/null && pwd -P) || fail FMONITOR_DEPLOY_STATE_DIR
    path="$canonical/$(basename "$path")"
    [[ $path != "$ROOT" && $path != "$ROOT/"* ]] || fail FMONITOR_DEPLOY_STATE_DIR
    if [[ -e $path || -L $path ]]; then
      [[ -d $path && ! -L $path ]] || fail "$path_name"
      local path_mode path_owner
      path_mode=$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path"); path_owner=$(stat -c '%u' "$path" 2>/dev/null || stat -f '%u' "$path")
      [[ $path_mode == 700 && $path_owner == "$(id -u)" ]] || fail "$path_name"
    elif { [[ $path_name == FMONITOR_DEPLOY_STATE_DIR && $AUTO_STATE == true ]] || [[ $path_name == FMONITOR_BACKUP_ROOT && $AUTO_BACKUP == true ]]; } \
      && [[ $VERB != deploy && $VERB != check-config ]]; then
      fail "$path_name"
    fi
    printf -v "$path_name" '%s' "$path"
  done
  if [[ ${FMONITOR_TRUSTED_REQUEST_SCHEME} == http ]]; then
    [[ ${FMONITOR_ALLOW_HTTP} == true && ${FMONITOR_PUBLIC_BASE_URL} =~ ^http://127\.0\.0\.1: && ${FMONITOR_TRUSTED_REQUEST_HOST} =~ ^127\.0\.0\.1: ]] || fail FMONITOR_ALLOW_HTTP
  else [[ ${FMONITOR_TRUSTED_REQUEST_SCHEME} == https && ( ${FMONITOR_PUBLIC_BASE_URL} == "https://${FMONITOR_TRUSTED_REQUEST_HOST}" || ${FMONITOR_PUBLIC_BASE_URL} == "https://${FMONITOR_TRUSTED_REQUEST_HOST}/"* ) ]] || fail FMONITOR_PUBLIC_BASE_URL; fi
  if [[ ${FMONITOR_JOBS_ENABLED} == true ]]; then
    for k in FMONITOR_BITRIX_WEBHOOK_URL FMONITOR_BITRIX_DEPARTMENT_IDS_JSON FMONITOR_ERP_HOST FMONITOR_ERP_DATABASE FMONITOR_ERP_USER FMONITOR_ERP_PASSWORD FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY; do need "$k"; done
    local smtp_present=0 smtp_value
    for k in FMONITOR_SMTP_HOST FMONITOR_SMTP_USERNAME FMONITOR_SMTP_PASSWORD FMONITOR_SMTP_FROM_ADDRESS; do
      smtp_value=${!k-}; [[ $smtp_value =~ [^[:space:]] ]] && smtp_present=$((smtp_present+1))
    done
    [[ $smtp_present == 0 || $smtp_present == 4 ]] || fail FMONITOR_SMTP_HOST
    if [[ $smtp_present == 4 ]]; then
      for k in FMONITOR_SMTP_HOST FMONITOR_SMTP_USERNAME FMONITOR_SMTP_PASSWORD FMONITOR_SMTP_FROM_ADDRESS; do need "$k"; done
    fi
    [[ ${FMONITOR_BITRIX_WEBHOOK_URL} =~ ^https://[A-Za-z0-9._:-]+/rest/[1-9][0-9]*/[A-Za-z0-9_-]+/?$ ]] || fail FMONITOR_BITRIX_WEBHOOK_URL
    [[ ${FMONITOR_BITRIX_DEPARTMENT_IDS_JSON} =~ ^\[[0-9,]+\]$ ]] || fail FMONITOR_BITRIX_DEPARTMENT_IDS_JSON
    if [[ -n ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL:-} ]]; then
      [[ ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL} =~ ^https://[A-Za-z0-9._:-]+/rest/[1-9][0-9]*/[A-Za-z0-9_-]+/?$ ]] || fail FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL
      [[ ${FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID:-} =~ ^[1-9][0-9]*$ ]] || fail FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID
    else [[ -z ${FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID:-} ]] || fail FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID; fi
  fi
  if [[ -n ${FMONITOR_IMAGE_ARCHIVE:-} ]]; then [[ ${FMONITOR_IMAGE_ARCHIVE} == /* && ${FMONITOR_IMAGE_ARCHIVE_SHA256:-} =~ ^[0-9a-f]{64}$ ]] || fail FMONITOR_IMAGE_ARCHIVE_SHA256; fi
}

export_config(){
  local k
  for k in $CONFIG_KEYS; do export "$k"; done
  export FMONITOR_IMAGE_MODE FMONITOR_RUNTIME_IMAGE FMONITOR_APPLICATION_IMAGE_ID FMONITOR_APPLICATION_PLATFORM FMONITOR_SOURCE_REVISION
}
dc(){ docker compose --env-file /dev/null -p "${COMPOSE_PROJECT_NAME}" -f "$COMPOSE_FILE" "$@"; }
writers(){ local a=(php web); [[ ${FMONITOR_JOBS_ENABLED} == true ]] && a+=(jobs-worker jobs-scheduler); printf '%s\n' "${a[@]}"; }

lock(){
  local mode owner parent
  parent=$(dirname "$FMONITOR_DEPLOY_STATE_DIR")
  [[ -d $parent && ! -L $parent ]] || fail FMONITOR_DEPLOY_STATE_DIR
  if [[ ! -e $FMONITOR_DEPLOY_STATE_DIR ]]; then (umask 077; mkdir "$FMONITOR_DEPLOY_STATE_DIR") || fail FMONITOR_DEPLOY_STATE_DIR; fi
  [[ -d $FMONITOR_DEPLOY_STATE_DIR && ! -L $FMONITOR_DEPLOY_STATE_DIR ]] || fail FMONITOR_DEPLOY_STATE_DIR
  mode=$(stat -c '%a' "$FMONITOR_DEPLOY_STATE_DIR" 2>/dev/null || stat -f '%Lp' "$FMONITOR_DEPLOY_STATE_DIR"); owner=$(stat -c '%u' "$FMONITOR_DEPLOY_STATE_DIR" 2>/dev/null || stat -f '%u' "$FMONITOR_DEPLOY_STATE_DIR")
  [[ $mode == 700 && $owner == "$(id -u)" ]] || fail FMONITOR_DEPLOY_STATE_DIR
  LOCK="/tmp/${COMPOSE_PROJECT_NAME}.lock"
  (umask 077; mkdir "$LOCK") 2>/dev/null || { note 'Production operation already running.' >&2; exit 75; }
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
}

prereq(){ docker info >/dev/null; docker compose version >/dev/null; }
image(){
  local acquire=${1:-acquire} mode=${FMONITOR_IMAGE_MODE} ref=${FMONITOR_RUNTIME_IMAGE} actual actual_platform database_actual database_platform
  if [[ $acquire == acquire && -n ${FMONITOR_IMAGE_ARCHIVE:-} ]]; then
    [[ -f ${FMONITOR_IMAGE_ARCHIVE} && ! -L ${FMONITOR_IMAGE_ARCHIVE} ]] || fail FMONITOR_IMAGE_ARCHIVE
    actual=$(sha256sum "${FMONITOR_IMAGE_ARCHIVE}" | awk '{print $1}'); [[ $actual == "${FMONITOR_IMAGE_ARCHIVE_SHA256}" ]] || fail FMONITOR_IMAGE_ARCHIVE_SHA256
    [[ $mode == local ]] && docker load -i "${FMONITOR_IMAGE_ARCHIVE}" >/dev/null
  fi
  if [[ $acquire == acquire ]]; then case $mode in
    build) [[ $(git rev-parse HEAD) == "${FMONITOR_SOURCE_REVISION}" && -z $(git status --porcelain --untracked-files=all) ]] || fail FMONITOR_SOURCE_REVISION; ! docker image inspect "$ref" >/dev/null 2>&1 || fail FMONITOR_RUNTIME_IMAGE; docker build --build-arg "FMONITOR_SOURCE_REVISION=${FMONITOR_SOURCE_REVISION}" -f "$ROOT/deploy/runtime/Dockerfile" -t "$ref" "$ROOT";;
    pull) [[ $ref == *@sha256:* ]] || fail FMONITOR_RUNTIME_IMAGE; docker pull "$ref";;
    local) :;;
  esac; fi
  actual=$(docker image inspect "$ref" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}') || fail FMONITOR_RUNTIME_IMAGE
  [[ $actual == "${FMONITOR_SOURCE_REVISION}" ]] || fail FMONITOR_SOURCE_REVISION
  IMAGE_ID=$(docker image inspect "$ref" --format '{{.Id}}'); [[ $IMAGE_ID =~ ^sha256:[0-9a-f]{64}$ ]] || fail FMONITOR_RUNTIME_IMAGE
  [[ -z ${FMONITOR_APPLICATION_IMAGE_ID:-} || $IMAGE_ID == "$FMONITOR_APPLICATION_IMAGE_ID" ]] || fail FMONITOR_APPLICATION_IMAGE_ID
  FMONITOR_APPLICATION_IMAGE_ID=$IMAGE_ID; export FMONITOR_APPLICATION_IMAGE_ID
  actual_platform=$(docker image inspect "$ref" --format '{{.Os}}/{{.Architecture}}') || fail FMONITOR_APPLICATION_PLATFORM
  [[ -z ${FMONITOR_APPLICATION_PLATFORM:-} || $actual_platform == "$FMONITOR_APPLICATION_PLATFORM" ]] || fail FMONITOR_APPLICATION_PLATFORM
  FMONITOR_APPLICATION_PLATFORM=$actual_platform; export FMONITOR_APPLICATION_PLATFORM
  if ! docker image inspect "$FMONITOR_DATABASE_IMAGE" >/dev/null 2>&1; then
    [[ $acquire == acquire && $mode != local ]] || fail FMONITOR_DATABASE_IMAGE
    docker pull "$FMONITOR_DATABASE_IMAGE" >/dev/null || fail FMONITOR_DATABASE_IMAGE
  fi
  database_actual=$(docker image inspect "$FMONITOR_DATABASE_IMAGE" --format '{{.Id}}') || fail FMONITOR_DATABASE_IMAGE
  database_platform=$(docker image inspect "$FMONITOR_DATABASE_IMAGE" --format '{{.Os}}/{{.Architecture}}') || fail FMONITOR_DATABASE_PLATFORM
  [[ -z ${FMONITOR_DATABASE_IMAGE_ID:-} || $database_actual == "$FMONITOR_DATABASE_IMAGE_ID" ]] || fail FMONITOR_DATABASE_IMAGE_ID
  [[ -z ${FMONITOR_DATABASE_PLATFORM:-} || $database_platform == "$FMONITOR_DATABASE_PLATFORM" ]] || fail FMONITOR_DATABASE_PLATFORM
  [[ $actual_platform == "$database_platform" ]] || fail FMONITOR_DATABASE_PLATFORM
  FMONITOR_DATABASE_IMAGE_ID=$database_actual; FMONITOR_DATABASE_PLATFORM=$database_platform
  export FMONITOR_DATABASE_IMAGE_ID FMONITOR_DATABASE_PLATFORM
}

ensure_unowned_or_owned(){
  local receipt="${FMONITOR_DEPLOY_STATE_DIR}/installed"
  if [[ -f $receipt ]]; then
    local recorded actual identity_expected identity_actual resource kind
    grep -qx "project=${COMPOSE_PROJECT_NAME}" "$receipt" || fail COMPOSE_PROJECT_NAME
    identity_expected=$(sed -n 's/^identity_hash=//p' "$receipt")
    identity_actual=$(printf '%s\0' "$COMPOSE_PROJECT_NAME" "$FMONITOR_DB_NAME" "$FMONITOR_DB_USER" "$FMONITOR_DB_PASSWORD" "$FMONITOR_PROCESS_TABLE_PREFIX" "$FMONITOR_SESSION_INSTANCE" "$FMONITOR_YII_COOKIE_VALIDATION_KEY" "$FMONITOR_YII_IDENTITY_KEY" | sha256sum | awk '{print $1}')
    [[ $identity_expected == "$identity_actual" ]] || fail FMONITOR_YII_IDENTITY_KEY
    for resource in database state secrets; do
      recorded=$(sed -n "s/^${resource}_id=//p" "$receipt")
      if [[ $recorded != pending ]]; then actual=$(volume_identity "${COMPOSE_PROJECT_NAME}_${resource}") || fail COMPOSE_PROJECT_NAME; [[ $actual == "$recorded" ]] || fail COMPOSE_PROJECT_NAME; fi
    done
    recorded=$(sed -n 's/^network_id=//p' "$receipt")
    if [[ $recorded != pending ]]; then actual=$(network_identity "${COMPOSE_PROJECT_NAME}_default") || fail COMPOSE_PROJECT_NAME; [[ $actual == "$recorded" ]] || fail COMPOSE_PROJECT_NAME; fi
    return
  fi
  local existing; existing=$(docker ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME}")
  [[ -z $existing ]] || fail COMPOSE_PROJECT_NAME
  for suffix in database state secrets; do docker volume inspect "${COMPOSE_PROJECT_NAME}_${suffix}" >/dev/null 2>&1 && fail COMPOSE_PROJECT_NAME || true; done
  docker network inspect "${COMPOSE_PROJECT_NAME}_default" >/dev/null 2>&1 && fail COMPOSE_PROJECT_NAME || true
}

stage_integrations(){
  if [[ $FMONITOR_JOBS_ENABLED == true ]]; then
    local bitrix="${FMONITOR_DEPLOY_STATE_DIR}/bitrix.json" document=null
    [[ -z ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL:-} ]] || document="\"${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL}\""
    (umask 077; printf '{"baseUrl":"%s","departments":%s,"documentBaseUrl":%s}\n' "$FMONITOR_BITRIX_WEBHOOK_URL" "$FMONITOR_BITRIX_DEPARTMENT_IDS_JSON" "$document" >"$bitrix") || return 1
    export FMONITOR_BITRIX_CONFIG_HOST_FILE=$bitrix
    dc --profile deployment run --rm stage-runtime-secrets || return 1
  fi
}

qualify_integrations(){
  local stage command status=0
  if [[ $FMONITOR_JOBS_ENABLED != true ]]; then
    for stage in erp workforce documents; do note "INTEGRATION_CHECK $stage SKIPPED"; done
    return 0
  fi
  for stage in erp workforce documents; do
    if [[ $stage == documents && -z ${FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL:-} ]]; then
      note 'INTEGRATION_CHECK documents SKIPPED'
      continue
    fi
    case $stage in
      erp) command=erp-equipment-facts-sync/probe;;
      workforce) command=workforce-sync/run;;
      documents) command=bitrix-order-document-links-sync/run;;
    esac
    if dc --profile jobs run --rm --no-deps jobs-worker php bin/yii "$command" --interactive=0 >/dev/null 2>&1; then
      note "INTEGRATION_CHECK $stage OK"
    else
      note "INTEGRATION_CHECK $stage FAILED"
      status=1
    fi
  done
  return "$status"
}

provision(){
  dc up -d --wait db || return 1
  if grep -qx 'state=initializing' "${FMONITOR_DEPLOY_STATE_DIR}/installed" 2>/dev/null; then receipt initializing || return 1; fi
  dc --profile deployment run --rm -e FMONITOR_MIGRATION_DB_USER -e FMONITOR_MIGRATION_DB_PASSWORD --entrypoint php prepare bin/yii local-runtime/provision-database --interactive=0 || return 1
  dc --profile deployment run --rm initialize-state || return 1
  dc --profile deployment run --rm prepare || return 1
  stage_integrations || return 1
  dc --profile deployment run --rm migrate || return 1
  dc --profile deployment run --rm --entrypoint php prepare bin/fmonitor2-runtime-check.php || return 1
}

health(){
  dc exec -T php php bin/fmonitor2-runtime-check.php >/dev/null || return 1
  dc exec -T web curl --fail --silent --show-error --header "Host: ${FMONITOR_TRUSTED_REQUEST_HOST}" http://127.0.0.1:8080/health/ready >/dev/null || return 1
}

start_services(){ local a=(); while IFS= read -r x; do a+=("$x"); done < <(writers); dc up -d --wait "${a[@]}" || return 1; health || return 1; }

stop_all_writers(){ local service running=(); for service in jobs-scheduler jobs-worker web php; do dc ps --status running --services | grep -qx "$service" && running+=("$service") || true; done; if ((${#running[@]}>0)); then dc stop "${running[@]}" || return 1; fi; }

ensure_private_backup_root(){
  local path=$FMONITOR_BACKUP_ROOT parent canonical mode owner
  [[ $path == /* && $path != "$ROOT" && $path != "$ROOT/"* ]] || fail FMONITOR_BACKUP_ROOT
  parent=$(dirname "$path"); [[ -d $parent && ! -L $parent ]] || fail FMONITOR_BACKUP_ROOT
  canonical=$(cd "$parent" 2>/dev/null && pwd -P) || fail FMONITOR_BACKUP_ROOT
  [[ $canonical == "$parent" ]] || fail FMONITOR_BACKUP_ROOT
  mode=$(stat -c '%a' "$parent" 2>/dev/null || stat -f '%Lp' "$parent"); owner=$(stat -c '%u' "$parent" 2>/dev/null || stat -f '%u' "$parent")
  [[ $mode == 700 && $owner == "$(id -u)" ]] || fail FMONITOR_BACKUP_ROOT
  if [[ ! -e $path && ! -L $path ]]; then (umask 077; mkdir "$path") || fail FMONITOR_BACKUP_ROOT; fi
  [[ -d $path && ! -L $path ]] || fail FMONITOR_BACKUP_ROOT
  mode=$(stat -c '%a' "$path" 2>/dev/null || stat -f '%Lp' "$path"); owner=$(stat -c '%u' "$path" 2>/dev/null || stat -f '%u' "$path")
  [[ $mode == 700 && $owner == "$(id -u)" ]] || fail FMONITOR_BACKUP_ROOT
}

volume_identity(){ docker volume inspect "$1" --format '{{.Name}}|{{.Driver}}|{{.CreatedAt}}|{{json .Labels}}|{{json .Options}}' | sha256sum | awk '{print $1}'; }
network_identity(){ docker network inspect "$1" --format '{{.Id}}|{{.Created}}|{{.Driver}}|{{json .Labels}}|{{json .Options}}' | sha256sum | awk '{print $1}'; }
installed_env_path(){ printf '%s/installed.env\n' "$FMONITOR_DEPLOY_STATE_DIR"; }
persist_installed_env(){ local target tmp; target=$(installed_env_path) || return 1; tmp="$target.new.$$.$RANDOM"; (umask 077; cp "$ENV_FILE" "$tmp" && chmod 600 "$tmp") || { rm -f "$tmp"; return 1; }; mv "$tmp" "$target" || return 1; }

verify_receipt_images(){
  local installed="${FMONITOR_DEPLOY_STATE_DIR}/installed" ref expected actual
  ref=$(sed -n 's/^image=//p' "$installed"); expected=$(sed -n 's/^image_id=//p' "$installed")
  actual=$(docker image inspect "$ref" --format '{{.Id}}') || fail FMONITOR_RUNTIME_IMAGE
  [[ $actual == "$expected" ]] || fail FMONITOR_RUNTIME_IMAGE
  expected=$(sed -n 's/^source=//p' "$installed")
  [[ $(docker image inspect "$ref" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}') == "$expected" ]] || fail FMONITOR_SOURCE_REVISION
  expected=$(sed -n 's/^application_platform=//p' "$installed")
  [[ $(docker image inspect "$ref" --format '{{.Os}}/{{.Architecture}}') == "$expected" ]] || fail FMONITOR_APPLICATION_PLATFORM
  ref=$(sed -n 's/^database_image=//p' "$installed"); [[ $ref == "$FMONITOR_DATABASE_IMAGE" ]] || fail FMONITOR_DATABASE_IMAGE
  expected=$(sed -n 's/^database_image_id=//p' "$installed")
  [[ $(docker image inspect "$ref" --format '{{.Id}}') == "$expected" ]] || fail FMONITOR_DATABASE_IMAGE_ID
  expected=$(sed -n 's/^database_platform=//p' "$installed")
  [[ $(docker image inspect "$ref" --format '{{.Os}}/{{.Architecture}}') == "$expected" ]] || fail FMONITOR_DATABASE_PLATFORM
}

receipt(){
  local state=${1:-installed} tmp="${FMONITOR_DEPLOY_STATE_DIR}/installed.new.$$"
  local config_hash identity_hash database_id=pending state_id=pending secrets_id=pending network_id=pending
  config_hash=$(sha256sum "$ENV_FILE" | awk '{print $1}') || return 1
  identity_hash=$(printf '%s\0' "$COMPOSE_PROJECT_NAME" "$FMONITOR_DB_NAME" "$FMONITOR_DB_USER" "$FMONITOR_DB_PASSWORD" "$FMONITOR_PROCESS_TABLE_PREFIX" "$FMONITOR_SESSION_INSTANCE" "$FMONITOR_YII_COOKIE_VALIDATION_KEY" "$FMONITOR_YII_IDENTITY_KEY" | sha256sum | awk '{print $1}') || return 1
  if docker volume inspect "${COMPOSE_PROJECT_NAME}_database" >/dev/null 2>&1; then database_id=$(volume_identity "${COMPOSE_PROJECT_NAME}_database") || return 1; fi
  if docker volume inspect "${COMPOSE_PROJECT_NAME}_state" >/dev/null 2>&1; then state_id=$(volume_identity "${COMPOSE_PROJECT_NAME}_state") || return 1; fi
  if docker volume inspect "${COMPOSE_PROJECT_NAME}_secrets" >/dev/null 2>&1; then secrets_id=$(volume_identity "${COMPOSE_PROJECT_NAME}_secrets") || return 1; fi
  if docker network inspect "${COMPOSE_PROJECT_NAME}_default" >/dev/null 2>&1; then network_id=$(network_identity "${COMPOSE_PROJECT_NAME}_default") || return 1; fi
  (umask 077; printf 'project=%s\nsource=%s\nimage=%s\nimage_id=%s\napplication_platform=%s\ndatabase_image=%s\ndatabase_image_id=%s\ndatabase_platform=%s\ndatabase_id=%s\nstate_id=%s\nsecrets_id=%s\nnetwork_id=%s\nconfig_hash=%s\nidentity_hash=%s\nstate=%s\n' "${COMPOSE_PROJECT_NAME}" "${FMONITOR_SOURCE_REVISION}" "${FMONITOR_RUNTIME_IMAGE}" "$IMAGE_ID" "$FMONITOR_APPLICATION_PLATFORM" "$FMONITOR_DATABASE_IMAGE" "$FMONITOR_DATABASE_IMAGE_ID" "$FMONITOR_DATABASE_PLATFORM" "$database_id" "$state_id" "$secrets_id" "$network_id" "$config_hash" "$identity_hash" "$state" >"$tmp") || return 1
  if [[ $state == installed ]]; then persist_installed_env || return 1; fi
  mv "$tmp" "${FMONITOR_DEPLOY_STATE_DIR}/installed" || return 1
  chmod 600 "${FMONITOR_DEPLOY_STATE_DIR}/installed" || return 1
}

deploy(){
  lock; prereq
  local installed="${FMONITOR_DEPLOY_STATE_DIR}/installed"
  if [[ -f $installed ]]; then
    local configured_hash installed_hash recorded_source
    ensure_unowned_or_owned
    if grep -qx 'state=installed' "$installed"; then
      image verify
    elif grep -qx 'state=initializing' "$installed"; then
      recorded_source=$(sed -n 's/^source=//p' "$installed")
      if [[ $FMONITOR_IMAGE_MODE == build && $recorded_source != "$FMONITOR_SOURCE_REVISION" ]]; then
        verify_receipt_images
        image
        receipt initializing || return 1
      else
        image verify
      fi
    else
      fail update
    fi
    configured_hash=$(sha256sum "$ENV_FILE" | awk '{print $1}'); installed_hash=$(sed -n 's/^config_hash=//p' "$installed")
    grep -qx "source=${FMONITOR_SOURCE_REVISION}" "$installed" || fail update
    grep -qx "image=${FMONITOR_RUNTIME_IMAGE}" "$installed" || fail update
    grep -qx "image_id=$IMAGE_ID" "$installed" || fail update
    if grep -qx 'state=installed' "$installed"; then
      [[ $configured_hash == "$installed_hash" ]] || fail update
      start_services; return
    fi
    grep -qx 'state=initializing' "$installed" || fail update
  else
    image
    ensure_unowned_or_owned
    receipt initializing
  fi
  if ! provision \
    || ! dc --profile deployment run --rm -e FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD --entrypoint php prepare bin/fmonitor2-provision-initial-admin.php --email "${FMONITOR_INITIAL_OWNER_EMAIL}" \
    || ! qualify_integrations \
    || ! start_services \
    || ! receipt installed; then
    stop_all_writers || true
    receipt initializing || true
    return 1
  fi
}

installed(){ local mode=${1:-exact} f="${FMONITOR_DEPLOY_STATE_DIR}/installed" expected actual; [[ -f $f && ! -L $f ]] || fail installation; grep -qx "project=${COMPOSE_PROJECT_NAME}" "$f" || fail installation; grep -qx 'state=installed' "$f" || fail update; expected=$(sed -n 's/^identity_hash=//p' "$f"); actual=$(printf '%s\0' "$COMPOSE_PROJECT_NAME" "$FMONITOR_DB_NAME" "$FMONITOR_DB_USER" "$FMONITOR_DB_PASSWORD" "$FMONITOR_PROCESS_TABLE_PREFIX" "$FMONITOR_SESSION_INSTANCE" "$FMONITOR_YII_COOKIE_VALIDATION_KEY" "$FMONITOR_YII_IDENTITY_KEY" | sha256sum | awk '{print $1}'); [[ $expected == "$actual" ]] || fail FMONITOR_YII_IDENTITY_KEY; ensure_unowned_or_owned; if [[ $mode == exact ]]; then expected=$(sed -n 's/^config_hash=//p' "$f"); actual=$(sha256sum "$ENV_FILE" | awk '{print $1}'); [[ $expected == "$actual" ]] || fail update; grep -qx "source=${FMONITOR_SOURCE_REVISION}" "$f" || fail update; grep -qx "image=${FMONITOR_RUNTIME_IMAGE}" "$f" || fail update; fi; }
installed_image(){ local receipt="${FMONITOR_DEPLOY_STATE_DIR}/installed" expected actual; expected=$(sed -n 's/^image_id=//p' "$receipt") || return 1; actual=$(docker image inspect "$FMONITOR_RUNTIME_IMAGE" --format '{{.Id}}') || fail FMONITOR_RUNTIME_IMAGE; [[ $actual == "$expected" ]] || fail FMONITOR_RUNTIME_IMAGE; expected=$(sed -n 's/^application_platform=//p' "$receipt"); [[ $(docker image inspect "$FMONITOR_RUNTIME_IMAGE" --format '{{.Os}}/{{.Architecture}}') == "$expected" ]] || fail FMONITOR_APPLICATION_PLATFORM; grep -qx "database_image=${FMONITOR_DATABASE_IMAGE}" "$receipt" || fail FMONITOR_DATABASE_IMAGE; expected=$(sed -n 's/^database_image_id=//p' "$receipt"); [[ $(docker image inspect "$FMONITOR_DATABASE_IMAGE" --format '{{.Id}}') == "$expected" ]] || fail FMONITOR_DATABASE_IMAGE_ID; expected=$(sed -n 's/^database_platform=//p' "$receipt"); [[ $(docker image inspect "$FMONITOR_DATABASE_IMAGE" --format '{{.Os}}/{{.Architecture}}') == "$expected" ]] || fail FMONITOR_DATABASE_PLATFORM; }
installed_database_image(){ local receipt="${FMONITOR_DEPLOY_STATE_DIR}/installed" expected; grep -qx "database_image=${FMONITOR_DATABASE_IMAGE}" "$receipt" || fail FMONITOR_DATABASE_IMAGE; expected=$(sed -n 's/^database_image_id=//p' "$receipt"); [[ $(docker image inspect "$FMONITOR_DATABASE_IMAGE" --format '{{.Id}}') == "$expected" ]] || fail FMONITOR_DATABASE_IMAGE_ID; expected=$(sed -n 's/^database_platform=//p' "$receipt"); [[ $(docker image inspect "$FMONITOR_DATABASE_IMAGE" --format '{{.Os}}/{{.Architecture}}') == "$expected" ]] || fail FMONITOR_DATABASE_PLATFORM; }

stop_cmd(){ lock; installed any; stop_all_writers; }
start_cmd(){ lock; installed; installed_image; start_services; }
service_healthy(){ local id; id=$(dc ps -q "$1") || return 1; [[ -n $id ]] || return 1; [[ $(docker inspect "$id" --format '{{.State.Status}}:{{if .State.Health}}{{.State.Health.Status}}{{end}}') == running:healthy ]]; }
status_cmd(){ installed; installed_image; dc ps; health || return 1; if [[ $FMONITOR_JOBS_ENABLED == true ]]; then service_healthy jobs-worker || return 1; service_healthy jobs-scheduler || return 1; else ! dc ps --status running --services | grep -Eq '^jobs-(worker|scheduler)$' || fail FMONITOR_JOBS_ENABLED; note 'jobs: disabled'; fi; }

if [[ -f "$ROOT/deploy/production/recovery.sh" ]]; then
  source "$ROOT/deploy/production/recovery.sh"
else
  do_backup(){ fail recovery; }; update_cmd(){ fail recovery; }; restore_cmd(){ fail recovery; }; release_cmd(){ fail recovery; }
fi

main(){
  parse_args "$@"
  [[ $VERB == env-init ]] && { env_init; return; }
  [[ $VERB != deploy ]] || prepare_deploy_env_file
  while IFS='=' read -r inherited _; do case $inherited in FMONITOR_*|COMPOSE_*) unset "$inherited";; esac; done < <(env)
  load_config
  finalize_prepared_env
  if [[ $VERB == is-production ]]; then [[ ${FMONITOR_RUNTIME_ENV:-} == production && ${COMPOSE_PROJECT_NAME:-} =~ ^fm2-prod- ]] && return 0; return 1; fi
  resolve_auto_paths
  resolve_build_identity
  validate
  [[ $VERB == check-config ]] && return
  [[ $VERB != deploy ]] || prepare_managed_paths
  export_config
  case $VERB in
    deploy) deploy;; status) status_cmd;; logs) installed; installed_image; dc logs --follow;; stop) stop_cmd;; start) start_cmd;; backup) do_backup;; update) update_cmd;; restore) restore_cmd;; release) release_cmd;; *) fail verb;;
  esac
}
main "$@"
