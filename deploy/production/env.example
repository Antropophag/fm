COMPOSE_PROJECT_NAME=fm2-prod-fmonitor
FMONITOR_IMAGE_MODE=@IMAGE_MODE@
FMONITOR_RUNTIME_IMAGE=@RUNTIME_IMAGE@
FMONITOR_APPLICATION_IMAGE_ID=@APPLICATION_IMAGE_ID@
FMONITOR_DATABASE_IMAGE=@DATABASE_IMAGE@
FMONITOR_DATABASE_IMAGE_ID=@DATABASE_IMAGE_ID@
FMONITOR_APPLICATION_PLATFORM=@APPLICATION_PLATFORM@
FMONITOR_DATABASE_PLATFORM=@DATABASE_PLATFORM@
FMONITOR_IMAGE_ARCHIVE=@IMAGE_ARCHIVE@
FMONITOR_IMAGE_ARCHIVE_SHA256=@IMAGE_ARCHIVE_SHA256@
FMONITOR_SOURCE_REVISION=@SOURCE_REVISION@
FMONITOR_HTTP_PORT=8093
FMONITOR_DB_NAME=fmonitor2
FMONITOR_DB_USER=fmonitor_runtime
FMONITOR_DB_PASSWORD=@GENERATE@
FMONITOR_MIGRATION_DB_USER=root
FMONITOR_MIGRATION_DB_PASSWORD=@GENERATE@
FMONITOR_PROCESS_TABLE_PREFIX=fm2_
FMONITOR_LEGACY_TABLE_PREFIX=fm2_
FMONITOR_SESSION_INSTANCE=production
FMONITOR_YII_COOKIE_VALIDATION_KEY=@GENERATE@
FMONITOR_YII_IDENTITY_KEY=@GENERATE@
FMONITOR_TRUSTED_REQUEST_HOST=replace_me
FMONITOR_TRUSTED_REQUEST_SCHEME=https
FMONITOR_RUNTIME_ENV=production
FMONITOR_PUBLIC_BASE_URL=https://replace_me
FMONITOR_ALLOW_HTTP=false
FMONITOR_INITIAL_OWNER_EMAIL=replace_me@shlz.ru
FMONITOR_BOOTSTRAP_SUPERADMIN_PASSWORD=@GENERATE@
FMONITOR_JOBS_ENABLED=false
FMONITOR_DEPLOY_STATE_DIR=auto
FMONITOR_BACKUP_ROOT=auto
FMONITOR_BITRIX_WEBHOOK_URL=
FMONITOR_BITRIX_ORDER_DOCUMENT_WEBHOOK_URL=
FMONITOR_BITRIX_ORDER_DOCUMENT_ROOT_ID=
FMONITOR_BITRIX_DEPARTMENT_IDS_JSON=
FMONITOR_ERP_HOST=
FMONITOR_ERP_DATABASE=
FMONITOR_ERP_USER=
FMONITOR_ERP_PASSWORD=
FMONITOR_ERP_EQUIPMENT_FACTS_HMAC_KEY=@GENERATE@
FMONITOR_ERP_EQUIPMENT_FACTS_TIMEOUT_SECONDS=30
FMONITOR_ERP_EQUIPMENT_FACTS_MAX_ROWS=500
FMONITOR_ERP_EQUIPMENT_FACTS_CHUNK_SIZE=100
FMONITOR_SMTP_HOST=
FMONITOR_SMTP_PORT=587
FMONITOR_SMTP_ENCRYPTION=tls
FMONITOR_SMTP_USERNAME=
FMONITOR_SMTP_PASSWORD=
FMONITOR_SMTP_FROM_ADDRESS=
FMONITOR_SMTP_FROM_NAME=FMonitor
FMONITOR_SMTP_TIMEOUT_SECONDS=10
FMONITOR_SMTP_VERIFY_PEER=true
