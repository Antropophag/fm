#!/usr/bin/env bash
set -euo pipefail
env_file=${1:?}; defaults=${2:?}; archive=${3:?}
[[ -f $env_file && ! -L $env_file && -f $defaults && ! -L $defaults && -f $archive && ! -L $archive ]] || exit 64
mode=$(stat -c '%a' "$env_file" 2>/dev/null || stat -f '%Lp' "$env_file")
[[ $mode == 600 ]] || exit 64
release_value(){ sed -n "s/^$1=//p" "$defaults"; }
image=$(release_value FMONITOR_RUNTIME_IMAGE); source_revision=$(release_value FMONITOR_SOURCE_REVISION); archive_sha=$(release_value FMONITOR_IMAGE_ARCHIVE_SHA256)
[[ $image != *$'\n'* && $source_revision =~ ^[0-9a-f]{40}$ && $archive_sha =~ ^[0-9a-f]{64}$ ]] || exit 64
tmp="$env_file.release.$$.$RANDOM"
(umask 077; : >"$tmp")
while IFS= read -r line || [[ -n $line ]]; do
  case $line in
    FMONITOR_IMAGE_MODE=*) printf 'FMONITOR_IMAGE_MODE=local\n';;
    FMONITOR_RUNTIME_IMAGE=*) printf 'FMONITOR_RUNTIME_IMAGE=%s\n' "$image";;
    FMONITOR_IMAGE_ARCHIVE=*) printf 'FMONITOR_IMAGE_ARCHIVE=%s\n' "$archive";;
    FMONITOR_IMAGE_ARCHIVE_SHA256=*) printf 'FMONITOR_IMAGE_ARCHIVE_SHA256=%s\n' "$archive_sha";;
    FMONITOR_SOURCE_REVISION=*) printf 'FMONITOR_SOURCE_REVISION=%s\n' "$source_revision";;
    *) printf '%s\n' "$line";;
  esac
done <"$env_file" >"$tmp"
chmod 600 "$tmp"; mv "$tmp" "$env_file"
