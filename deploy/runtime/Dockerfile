RUN find /workspace/fmonitor-2 /workspace/shlz-ui -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    | sha256sum \
    | cut -d' ' -f1 > /tmp/fmonitor2-runtime-build-id \
    && mkdir -p /usr/local/share/fmonitor2 \
