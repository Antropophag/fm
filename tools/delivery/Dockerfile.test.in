FROM @PHP_IMAGE@

# Test-only Linux tools for permission and descriptor-capture probes.
RUN apt-get update \
    && apt-get install -y --no-install-recommends util-linux libjpeg62-turbo-dev libpng-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" gd mysqli pcntl \
    && rm -rf /var/lib/apt/lists/*
